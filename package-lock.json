{
  "name": "fairwire-agents",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fairwire-agents",
      "license": "MIT",
      "workspaces": [
        "packages/fairwire-core",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/fairwire-core": {
      "resolved": "packages/fairwire-core",
      "link": true
    },
    "node_modules/iris-of-traffic": {
      "resolved": "packages/iris-of-traffic",
      "link": true
    },
    "packages/fairwire-core": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "fairwire-approve": "bin/fairwire-approve.js",
        "fairwire-license": "bin/fairwire-license.js",
        "fairwire-new-agent": "bin/fairwire-new-agent.js",
        "fairwire-verify-log": "bin/fairwire-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/iris-of-traffic": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "fairwire-core": "^0.1.0"
      },
      "bin": {
        "iris-of-traffic": "bin/iris-of-traffic.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
