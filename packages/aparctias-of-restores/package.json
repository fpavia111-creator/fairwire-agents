    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "aparctias-of-restores": "bin/aparctias-of-restores.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/aparctias-of-restores.js demo",
    "eval": "node bin/aparctias-of-restores.js eval"
  },
  "dependencies": {
    "fairwire-core": "^0.1.0"
  },
  "repository": {
