{
  "name": "fairwire-asset-inventory",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairwire-asset-inventory",
  "description": "Fairwire Asset Inventory: Asset inventory against the CMDB: devices seen on the network or in device management but missing from the CMDB, CMDB records not seen for months, duplicate serial numbers, retired records still active, missing owners or locations, and warranties ending. Drafts CMDB fix lists; never edits the CMDB.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairwire-asset-inventory": "bin/fairwire-asset-inventory.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairwire-asset-inventory.js demo",
    "eval": "node bin/fairwire-asset-inventory.js eval"
  },
  "dependencies": {
    "fairwire-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairwire-agents.git",
    "directory": "packages/fairwire-asset-inventory"
  },
  "homepage": "https://github.com/fpavia111-creator/fairwire-agents/tree/master/packages/fairwire-asset-inventory#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "it-operations",
    "network",
    "fairwire",
    "cmdb",
    "asset-management",
    "itam",
    "inventory",
    "servicenow"
  ]
}
