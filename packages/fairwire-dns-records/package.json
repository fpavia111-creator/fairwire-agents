{
  "name": "fairwire-dns-records",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairwire-dns-records",
  "description": "Fairwire DNS Records: DNS zone hygiene from a zone export: names pointing at cloud services that may no longer exist (takeover risk), public names pointing at private addresses, duplicate and conflicting records, very short or very long TTLs, wildcards and records pointing at addresses you no longer own. Drafts a change request; never edits DNS.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairwire-dns-records": "bin/fairwire-dns-records.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairwire-dns-records.js demo",
    "eval": "node bin/fairwire-dns-records.js eval"
  },
  "dependencies": {
    "fairwire-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairwire-agents.git",
    "directory": "packages/fairwire-dns-records"
  },
  "homepage": "https://github.com/fpavia111-creator/fairwire-agents/tree/master/packages/fairwire-dns-records#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "it-operations",
    "network",
    "fairwire",
    "dns",
    "zone-file",
    "subdomain-takeover",
    "dangling-cname",
    "dns-hygiene"
  ]
}
