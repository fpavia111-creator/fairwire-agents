    "./package.json": "./package.json"
  },
  "bin": {
    "fairwire-restore-tests": "bin/fairwire-restore-tests.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairwire-restore-tests.js demo",
    "eval": "node bin/fairwire-restore-tests.js eval"
  },
  "dependencies": {
