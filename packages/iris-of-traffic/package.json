{
  "name": "iris-of-traffic",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/iris-of-traffic",
  "description": "Iris of Traffic: Network flow review from a NetFlow, IPFIX or sFlow export: cleartext protocols, risky ports reached from the internet, one host or destination taking most of the bytes, large uploads out of hours and very small packets. Writes a worklist and drafts a change request a network owner applies.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "iris-of-traffic": "bin/iris-of-traffic.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/iris-of-traffic.js demo",
    "eval": "node bin/iris-of-traffic.js eval"
  },
  "dependencies": {
    "fairwire-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairwire-agents.git",
    "directory": "packages/iris-of-traffic"
  },
  "homepage": "https://github.com/fpavia111-creator/fairwire-agents/tree/main/packages/iris-of-traffic#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "it-operations",
    "network",
    "fairwire",
    "netflow",
    "ipfix",
    "sflow",
    "network-traffic",
    "top-talkers"
  ]
}
