{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/skiron-of-patches",
  "title": "Skiron of Patches",
  "description": "Skiron of Patches: Patch status review from WSUS, Intune, SCCM or any patch export: critical and…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents",
    "source": "github",
    "subfolder": "packages/skiron-of-patches"
  },
  "websiteUrl": "https://fair-agents.com/fairwire.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "skiron-of-patches",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
