{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/libeccio-of-telecom",
  "title": "Libeccio of Telecom",
  "description": "Libeccio of Telecom: Telecom bill review: mobile lines with no use for months, lines still billed…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents",
    "source": "github",
    "subfolder": "packages/libeccio-of-telecom"
  },
  "websiteUrl": "https://fair-agents.com/fairwire.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "libeccio-of-telecom",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
