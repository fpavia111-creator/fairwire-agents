{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/boreas-of-firewalls",
  "title": "Boreas of Firewalls",
  "description": "Boreas of Firewalls: Firewall rule review from a rule export (Palo Alto, FortiGate or any CSV)…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents",
    "source": "github",
    "subfolder": "packages/boreas-of-firewalls"
  },
  "websiteUrl": "https://fair-agents.com/fairwire.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "boreas-of-firewalls",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
