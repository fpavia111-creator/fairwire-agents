{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/argestes-of-assets",
  "title": "Argestes of Assets",
  "description": "Argestes of Assets: Asset inventory against the CMDB: devices seen on the network or in device…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairwire-agents",
    "source": "github",
    "subfolder": "packages/argestes-of-assets"
  },
  "websiteUrl": "https://fair-agents.com/fairwire.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "argestes-of-assets",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
