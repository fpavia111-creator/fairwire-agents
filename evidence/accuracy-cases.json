{
  "about": "Accuracy cases for scripts/accuracy.mjs (npm run accuracy). expected: every finding (code|key) the planted fixtures should give, written from the planted problems in each fixtures/README.md and checked line by line on 19 Nov 2026. drop and repair turn the fixtures into a clean set (no finding expected): drop removes the planted rows, repair sets a planted value back to a normal one. mutations change one row of the clean set and name the finding expected. A selector is [column, value] or {column: value} (all must match); /regex/ values are regular expressions.",
  "agents": {
    "fairwire-admin-roles": {
      "expected": [
        "admin_reads_mail|bkim@corp.example",
        "admin_without_mfa|dlee@corp.example",
        "break_glass_no_note|bg2@corp.example",
        "break_glass_signed_in|bg1@corp.example",
        "guest_with_admin_role|partner_it#EXT#@corp.example",
        "stale_admin|fnunez@corp.example",
        "standing_admin|bkim@corp.example",
        "standing_admin|partner_it#EXT#@corp.example",
        "too_many_global_admins|global-admins"
      ],
      "drop": [
        ["user", "/^(bkim|dlee|fnunez|bg1|bg2|partner_it)/"]
      ],
      "mutations": [
        {
          "id": "admin-loses-mfa",
          "where": ["user", "aortiz@corp.example"],
          "set": {
            "mfa": ""
          },
          "expect": "admin_without_mfa"
        },
        {
          "id": "permanent-assignment",
          "where": ["user", "cdiaz@corp.example"],
          "set": {
            "assignment_type": "Active (permanent)"
          },
          "expect": "standing_admin"
        },
        {
          "id": "admin-goes-quiet",
          "where": ["user", "emoss@corp.example"],
          "set": {
            "last_sign_in": "2026-05-01"
          },
          "all": true,
          "expect": "stale_admin"
        }
      ]
    },
